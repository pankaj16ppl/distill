# Dockerfile.frontend  (lives in the PROJECT ROOT, next to index.html)
# ------------------------------------------------------------
# The frontend is plain HTML/CSS/JS — no build step needed.
# We just need a tiny web server to serve the files to the browser.
# nginx is a fast, well-known one, and its "alpine" image is very small.
# ------------------------------------------------------------

FROM nginx:alpine

# Copy the whole project into nginx's web-root folder.
# The root .dockerignore (see that file) tells Docker to skip everything
# that ISN'T part of the frontend — backend/, node_modules, docs, etc. —
# so only index.html, the other .html pages, css/, js/, and assets/ end up here.
COPY . /usr/share/nginx/html

# nginx listens on port 80 inside the container by default.
EXPOSE 80

# No CMD needed — the base nginx image already knows how to start itself.
